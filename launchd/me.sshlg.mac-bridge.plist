<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: mac-bridge menu-bar app in the user's Aqua GUI session.
     Menu bar + consent dialogs work here; TCC-gated screen reads need the
     signed .app (scripts/build_app.sh, a follow-up). Install:
       cp launchd/*.plist ~/Library/LaunchAgents/ && launchctl load it -->
<plist version="1.0"><dict>
  <key>Label</key><string>me.sshlg.mac-bridge</string>
  <key>ProgramArguments</key><array><string>/Users/sshlg/DATA/mac-bridge/scripts/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardErrorPath</key><string>/tmp/mac-bridge.err</string>
  <key>StandardOutPath</key><string>/tmp/mac-bridge.out</string>
</dict></plist>
