pyproject.toml:
[project]
name = "vibe-bridge"
version = "0.1.0"
description = "vibe-bridge: пульт и руки робота на компьютере владельца — консент, панель, PWA"
# Публичный репозиторий без лицензии = все права сохранены; это и записано
# явно, чтобы сборка не выбирала лицензию за владельца. Открыть код (MIT, как
# у остальной семьи) можно в любой момент — отозвать выданную лицензию нельзя.
license = "LicenseRef-Proprietary"
requires-python = ">=3.12"
dependencies = [
    # Wire parity with the robot: Hermes 0.19 ships mcp==1.26.0 as its MCP
    # client (its authors' own pin). Speaking the same SDK generation on the
    # server side removes a whole class of protocol-revision surprises —
    # 2026-08-28 the robot lost first HTTP transport, then the call path, to
    # exactly such a mismatch. Bump TOGETHER with the robot's HERMES_VERSION.
    "mcp==1.26.0",
    "pywebpush>=2.4.0",
]

[project.optional-dependencies]
# Per-OS capability packs. The core installs on any OS; a capability that
# needs a third-party lib degrades to an honest "install …[<os>]" error
# until the extra is present (vibebridge/platforms/*). rumps is macOS-only
# (menu bar); pystray backs the Win/Linux tray.
macos = ["rumps>=0.4"]
windows = ["mss>=9", "PyGetWindow>=0.0.9", "windows-toasts>=1.1", "pystray>=0.19"]
linux = ["mss>=9", "pystray>=0.19"]

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-timeout>=2.4.0",
    "ruff>=0.6",
    "rumps>=0.4",   # dev host is macOS — keep the tray runnable via `uv run`
    "briefcase>=0.4",   # builds the signed shell (ADR-0006); build-time only
]

# ---------------------------------------------------------------- packaging
# The signed shell (ADR-0006). It carries the Python runtime, every
# third-party dependency and a seed copy of `vibebridge`; the code that
# updates itself lives OUTSIDE the bundle and is chosen by `vbboot` at
# startup. Keeping every .so inside the signed bundle is what lets us run
# with library validation ON — see the entitlements below.
[tool.briefcase]
project_name = "vibe-bridge"
bundle = "me.sshlg"
version = "0.1.0"
url = "https://github.com/ssheleg/vibe-bridge"
author = "Sergei Sheleg"
author_email = "sergey@appvillis.com"

[tool.briefcase.app.vibe-bridge]
formal_name = "vibe-bridge"
description = "Пульт и руки робота на компьютере владельца"
long_description = """Мост между роботом и компьютером владельца: MCP-сервер с
консент-движком, панель, PWA для телефона и иконка в меню-баре.
"""
module_name = "vbboot"
icon = "packaging/vibe-bridge"
# Both packages ship inside the bundle: `vbboot` IS the shell, `vibebridge`
# is the seed payload a fresh install runs before it has updated once.
sources = ["vbboot", "vibebridge"]
test_sources = ["tests"]
requires = [
    "mcp==1.26.0",
    "pywebpush>=2.4.0",
]

[tool.briefcase.app.vibe-bridge.macOS]
universal_build = true
requires = [
    "rumps>=0.4",
    "pyobjc-framework-ServiceManagement>=12",   # SMAppService login item
]

# Info.plist
info."LSUIElement" = true        # menu-bar app: no Dock icon, no app switcher
info."NSAppleEventsUsageDescription" = "Мост выполняет действия, которые робот запросил у вас — открыть приложение, прочитать список окон. Каждое действие спрашивает разрешение отдельно."
info."NSSystemAdministrationUsageDescription" = "Скриншот экрана делается только по запросу робота и только после вашего разрешения."

# Entitlements. Briefcase grants the two below to every macOS app by default;
# we turn both OFF. Every Mach-O this process loads lives inside the signed
# bundle, so library validation costs us nothing and disabling it would earn
# the app extra Gatekeeper scrutiny for no reason (ADR-0006).
entitlement."com.apple.security.cs.disable-library-validation" = false
entitlement."com.apple.security.cs.allow-unsigned-executable-memory" = false

[tool.ruff]
line-length = 88
target-version = "py312"
# docs/ux/lint.py is vendored from the super-ux plugin (upstream-owned;
# reseeded on plugin updates) — never edited here, so never linted here.
extend-exclude = ["docs/ux/lint.py"]

[tool.ruff.lint]
# Standard, well-scoped set: pycodestyle, pyflakes, isort, bugbear.
select = ["E", "F", "I", "B"]
ignore = ["E501"]  # long lines in generated exec-src / comments

[tool.pytest.ini_options]
testpaths = ["tests"]
timeout = 60

